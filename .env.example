# Copy to .env and fill in values:
#   cp .env.example .env

# --- OpenWeather API (required) ---
# Free key: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here
API_BASE_URL=https://api.openweathermap.org/data/2.5/weather

# --- PostgreSQL ---
# Local runs: DB_HOST=localhost, DB_PORT=5435
# Docker ETL service overrides these to postgres:5432 via docker-compose.yml
DB_HOST=localhost
DB_PORT=5435
DB_NAME=weather_analytics
DB_USER=postgres
DB_PASSWORD=postgres

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/weather_etl.log
# LOG_FORMAT=text
# STRUCTURED_LOGGING=true

# --- Extract performance ---
# EXTRACT_WORKERS=4
# API_RATE_LIMIT_DELAY=0.2

# --- HTTP / retry (optional overrides; defaults in config/config.py) ---
# REQUEST_TIMEOUT=10
# MAX_RETRIES=3
# RETRY_DELAY=5
