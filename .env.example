# Copy to .env and fill in values:
#   cp .env.example .env

# --- OpenWeather API (required) ---
# Free key: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here
API_BASE_URL=https://api.openweathermap.org/data/2.5/weather

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5435
DB_NAME=weather_analytics
DB_USER=postgres
DB_PASSWORD=postgres

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/weather_etl.log

# --- HTTP / retry (optional overrides; defaults in config/config.py) ---
# REQUEST_TIMEOUT=10
# MAX_RETRIES=3
# RETRY_DELAY=5
